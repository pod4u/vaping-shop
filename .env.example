# Supabase Configuration (รอตั้งค่า)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LINE Messaging API
# Required for Rich Menu, replying, push messages, and broadcasts.
# LINE Developers Console > Messaging API > Channel access token
LINE_CHANNEL_ACCESS_TOKEN=

# Required for verifying webhook signatures.
# LINE Developers Console > Basic settings > Channel secret
LINE_CHANNEL_SECRET=
LINE_BOT_USER_ID=
LINE_LOGIN_CHANNEL_ID=
NEXT_PUBLIC_LINE_LIFF_ID=

# Optional but recommended: LINE OA bot user ID (the webhook `destination`, starts with U).
# When omitted, the server resolves it from GET /v2/bot/info using the access token.
LINE_BOT_USER_ID=

# Thunder bank-slip verification (server-only). Register the receiver account
# in Thunder first so matchAccount=true can reject transfers to other accounts.
THUNDER_API_KEY=
# Exact private instructions pushed to the linked customer only; never render on the public website.
# Example: PAYMENT_INSTRUCTIONS=ธนาคาร...\nชื่อบัญชี...\nเลขบัญชี...
PAYMENT_INSTRUCTIONS=

# Server-only HMAC secret for one-time customer linking codes (32+ random characters).
# Generate separately from LINE_CHANNEL_SECRET and never prefix with NEXT_PUBLIC_.
CUSTOMER_LINK_TOKEN_SECRET=run-openssl-rand-base64-48

# Admin Panel Security
ADMIN_SECRET_PATH=xK9mP2qR        # เปลี่ยนเป็นอะไรก็ได้ที่ยากเดา
ADMIN_PASSWORD=your-secure-password  # รหัสผ่าน admin
ADMIN_SESSION_SECRET=run-openssl-rand-base64-48  # HMAC session; เปลี่ยนค่านี้เพื่อ logout ทุกบัญชี
# Optional staff accounts. Keep server-only and never prefix with NEXT_PUBLIC_.
# ADMIN_ACCOUNTS_JSON=[{"id":"staff-01","username":"order01","password":"change-me","role":"order_staff"}]

# Nightly Google Sheet stock import (server-only)
# Share the source Sheet with GOOGLE_SERVICE_ACCOUNT_EMAIL as Viewer.
GOOGLE_SERVICE_ACCOUNT_EMAIL=stock-reader@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_STOCK_SPREADSHEET_ID=
GOOGLE_STOCK_SHEET_RANGE=01_PRODUCTS!A:T
CRON_SECRET=run-openssl-rand-base64-32
# Keep false until a real vendor file has passed preview/reconciliation.
STOCK_IMPORT_AUTO_APPLY=false
STOCK_IMPORT_MAX_CHANGED_ROWS=500

# Website analytics dashboard (server-only; see docs/website-analytics-setup.md)
# Add this service account to the verified Search Console property with read access.
GSC_PROPERTY=sc-domain:pod4u.store
GSC_SERVICE_ACCOUNT_EMAIL=
GSC_SERVICE_ACCOUNT_PRIVATE_KEY=
# Dedicated read access to the Vercel project. Never use NEXT_PUBLIC_ for tokens.
ANALYTICS_VERCEL_TOKEN=
ANALYTICS_VERCEL_PROJECT_ID=prj_LIEiiyr3V5yRLdMYCYTKYjOvtLfy
ANALYTICS_VERCEL_TEAM_ID=team_hGZeKUjBiXqFFm1UDytOhYMU
# Daily analytics sync reuses CRON_SECRET above.

# App Configuration
# Production example: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
